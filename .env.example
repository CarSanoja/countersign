# Nutrient DWS son DOS productos con claves y créditos SEPARADOS sobre el mismo host.
# La clave de uno da 401 en el otro y parece un error de formato de cabecera.
# Extraction: 5.000 créditos/mes gratis, sin marca de agua.
# Processor:  50 créditos/mes gratis, PERO estampa "For Evaluation Purposes Only".
NUTRIENT_DATA_EXTRACTION_KEY=
NUTRIENT_PROCESSOR_KEY=

# 250 búsquedas/mes, 50/hora en plan Free. Una contraparte cuesta 3 créditos.
SERPAPI_API_KEY=

# CORE v1. El token de sandbox tarda hasta 15 min en activarse.
NAMECOM_USERNAME=tu-usuario-test
NAMECOM_TOKEN=
NAMECOM_ENV=sandbox

# El gateway valida api-key ANTES que el bearer: las dos son obligatorias.
# Requiere cuenta de EMPRESA Microsoft o Google; las personales no sirven.
DOCTAVIAN_BASE_URL=
DOCTAVIAN_API_KEY=
DOCTAVIAN_ACCESS_TOKEN=

# eSign NO tiene free tier self-serve: es via ventas, o trial de 30 dias en
# modo TEST donde todo sobre sale con marca de agua.
FOXIT_ESIGN_BASE_URL=
FOXIT_ESIGN_CLIENT_ID=
FOXIT_ESIGN_CLIENT_SECRET=

# Metadata API. Los ids de tabla se rellenan despues de crearlas.
XANO_TOKEN=
XANO_INSTANCE_DOMAIN=
XANO_WORKSPACE_ID=
XANO_VENDOR_TABLE_ID=
XANO_AUDIT_TABLE_ID=
